PORT=3001
DATABASE_URL=
DATABASE_SSL=false
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
API_SERVER_URL=http://localhost:3001/api
BLOB_READ_WRITE_TOKEN=

# Set Daraja credentials in .env.local or deployment secrets, never in source control.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=https://your-public-host/api/payments/callback
MPESA_CALLBACK_TOKEN=generate-a-long-random-token
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# SMTP sends paid event tickets. Use port 465 with SMTP_SECURE=true,
# or port 587 with SMTP_SECURE=false (STARTTLS is required).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EVENT_TICKET_FROM="NEYD Events <tickets@neydkenya.org>"

# Use server-controlled integer KES prices. An empty catalog disables checkout.
MPESA_CATALOG_JSON=[]
